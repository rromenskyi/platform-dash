# Copy to `.env` and fill in your OIDC client. `.env` is gitignored.
# Any OIDC provider works (Zitadel, Keycloak, Authentik, Dex, …).
# Redirect URI to register: http://localhost:5173/auth/callback/oidc

# OIDC issuer URL, no trailing slash.
AUTH_OIDC_ISSUER=https://id.example.com
AUTH_OIDC_CLIENT_ID=
# Leave empty for a public PKCE-only client.
AUTH_OIDC_CLIENT_SECRET=
# Sign-in button label.
# AUTH_OIDC_PROVIDER_NAME=SSO

# id_token claim with the user's roles/groups (dot path allowed).
# Default is Zitadel's project-roles claim; e.g. "groups" or
# "realm_access.roles" for Keycloak.
# DASH_ROLES_CLAIM=groups

# Cookie encryption key for Auth.js sessions.
# Generate with:  openssl rand -hex 32
AUTH_SECRET=

# Optional Grafana deeplink on the overview / monitoring pages.
# DASH_GRAFANA_URL=https://grafana.example.com

# Server-side HTTP tester target guard (/tools/http):
#   none     — any target
#   metadata — (default) block loopback + link-local (169.254.169.254)
#   private  — also block RFC1918/CGNAT/ULA and *.svc / *.cluster.local
# DASH_HTTP_TEST_BLOCK=metadata

# Legacy names, still honoured (provider id "zitadel", redirect URI
# .../auth/callback/zitadel): AUTH_ZITADEL_ISSUER / _ID / _SECRET.
