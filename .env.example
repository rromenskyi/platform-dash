# Copy to `.env` and fill in your Zitadel Application credentials.
# `.env` is gitignored.

# OIDC issuer — your Zitadel public URL, no trailing slash.
AUTH_ZITADEL_ISSUER=https://id.example.com

# OIDC client_id — Zitadel Console → Project → Application → Configuration.
AUTH_ZITADEL_ID=

# OIDC client_secret — leave empty for public PKCE-only clients
# (SPAs, mobile). Web/server-side apps need a real secret here.
AUTH_ZITADEL_SECRET=

# Cookie encryption key for Auth.js sessions.
# Generate with:  openssl rand -hex 32
AUTH_SECRET=

# Server-side HTTP tester target guard (/tools/http):
#   none     — any target
#   metadata — (default) block loopback + link-local (169.254.169.254)
#   private  — also block RFC1918/CGNAT/ULA and *.svc / *.cluster.local
# DASH_HTTP_TEST_BLOCK=metadata
